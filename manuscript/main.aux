\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Convex corner cuts move and resize the arctic circle without changing its shape. Exact liquidity $1-P_{\max }$ (Kasteleyn) of octagonal samples with through-block axis edges $|X|,|Y|\le 21$ and even $45^\circ $ cuts at offsets $(d_{\rm  NE},d_{\rm  NW},d_{\rm  SW},d_{\rm  SE})$: (a)~no cuts, (b)~$(32,32,32,32)$, (c)~$(24,24,42,42)$, (d)~$(32,42,38,36)$, which mixes the two offset classes. Red: circle inscribed in the remaining square (dashed) predicted by the octagon rule. Here and in Figs.~\ref {fig:switch} and \ref {fig:vacancy}, $P_{\max }$ is the largest pairing probability of a plaquette; all values are exact.}}{5}{figure.2}\protected@file@percent }
\newlabel{fig:octagons}{{2}{5}{Convex corner cuts move and resize the arctic circle without changing its shape. Exact liquidity $1-\Pmax $ (Kasteleyn) of octagonal samples with through-block axis edges $|X|,|Y|\le 21$ and even $45^\circ $ cuts at offsets $(d_{\rm NE},d_{\rm NW},d_{\rm SW},d_{\rm SE})$: (a)~no cuts, (b)~$(32,32,32,32)$, (c)~$(24,24,42,42)$, (d)~$(32,42,38,36)$, which mixes the two offset classes. Red: circle inscribed in the remaining square (dashed) predicted by the octagon rule. Here and in Figs.~\ref {fig:switch} and \ref {fig:vacancy}, $\Pmax $ is the largest pairing probability of a plaquette; all values are exact}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Reflex corners make the liquid region non-circular. (a)--(c)~Plus-shaped samples with arm reach $n=241$ and half-width $c$, from exact pairing probabilities (urban-renewal recursion, $6.6\times 10^4$ to $1.0\times 10^5$ plaquettes). Frozen plaquettes are colored by their ice phase, the orientation of the dominant pairing; liquid plaquettes fade to white. Black: the curve of Eq.~\eqref  {eq:closed}. (d)~Reflex corner of (a): a frozen pocket where three ice phases meet, bounded by two arcs of the curve. Below $c/n=1/3$ the plus has no tiling, and above $1/\sqrt  2$ the curve is the full circle.}}{5}{figure.3}\protected@file@percent }
\newlabel{fig:plus}{{3}{5}{Reflex corners make the liquid region non-circular. (a)--(c)~Plus-shaped samples with arm reach $n=241$ and half-width $c$, from exact pairing probabilities (urban-renewal recursion, $6.6\times 10^4$ to $1.0\times 10^5$ plaquettes). Frozen plaquettes are colored by their ice phase, the orientation of the dominant pairing; liquid plaquettes fade to white. Black: the curve of Eq.~\eqref {eq:closed}. (d)~Reflex corner of (a): a frozen pocket where three ice phases meet, bounded by two arcs of the curve. Below $c/n=1/3$ the plus has no tiling, and above $1/\sqrt 2$ the curve is the full circle}{figure.3}{}}
